PORT=5000
HOST=0.0.0.0
FLASK_DEBUG=true

# Plagiarism check (Hugging Face). Leave empty to disable.
HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Optional: override temp upload folder (default: system temp/blazeai_uploads)
# UPLOAD_DIR=/tmp

# Optional: SQLite database path (default: backend/data/blazeai.db)
# DATABASE_PATH=./data/blazeai.db

# Optional: request limits
# MAX_UPLOAD_MB=50
# MAX_IMAGES_PDF=20
# MAX_PLAGIARISM_CHARS=50000
# RATE_LIMIT_REQUESTS=60
# RATE_LIMIT_WINDOW_SEC=60
